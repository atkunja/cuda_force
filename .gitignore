# Build
build/
build-*/
cmake-build-*/
*.o
*.so
*.dylib
*.a
compile_commands.json
CMakeCache.txt
CMakeFiles/
Testing/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# PyTorch extension build artifacts
python/cudaforge/_C*.so
torch_extensions/

# Model + data artifacts
checkpoints/
runs/
*.safetensors
*.bin
!tests/**/*.bin

# Benchmark output. Results are generated on the machine that runs them;
# committing them would ship someone else's numbers. The README explaining that
# is tracked, so the directory survives a clean checkout.
benchmarks/results/*.json
benchmarks/results/*.csv
!benchmarks/results/README.md

# Profiling output
*.nsys-rep
*.ncu-rep
*.sqlite
*.qdrep

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
