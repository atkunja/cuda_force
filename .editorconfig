# Applies to every editor that understands the format, so formatting does not
# depend on whose machine a file was last opened on.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Matches .clang-format's IndentWidth.
[*.{c,cc,cpp,h,hpp,cu,cuh}]
indent_size = 4

# Matches ruff's default.
[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{md,markdown}]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown; stripping them would
# silently change rendering.
trim_trailing_whitespace = false

[*.sh]
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[Makefile]
indent_style = tab
